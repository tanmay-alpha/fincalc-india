# FinCalc India — Environment Variables
# Copy this file to `.env.local` and fill in your own values.
# DO NOT commit `.env.local` or `.env` to git — see .gitignore.
# Rotate any secret you have ever committed publicly (Google OAuth, DB URL, NextAuth secret).

# ─── Database (Neon / Render PostgreSQL) ─────────────────────
# Use the connection string provided by your database host. Always include ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────
# Generate a strong secret (>= 64 chars in production):
#   openssl rand -base64 48
NEXTAUTH_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48"
NEXTAUTH_URL="https://fincalc-india.vercel.app"

# ─── Google OAuth ─────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: https://fincalc-india.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Optional: Vercel deployment-time env (set in Vercel dashboard) ──
# Vercel automatically provides process.env.VERCEL_URL — no need to set NEXTAUTH_URL there
# if you configure it correctly per environment.
